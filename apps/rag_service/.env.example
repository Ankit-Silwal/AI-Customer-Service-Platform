SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=knowledge_service
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
# LLM: Gemini via OpenAI-compatible endpoint
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Only needed when LLM_PROVIDER=openai / EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# Embeddings: local HuggingFace
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMS=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=400
MAX_CHUNKS_PER_DOC=500
# Same Postgres as knowledge_service (only updates Document.status)
DATABASE_URL=
PORT=8001
